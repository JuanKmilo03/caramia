<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_caramia_shoe_reference_form" model="ir.ui.view">
        <field name="name">caramia.shoe.reference.form</field>
        <field name="model">caramia.shoe.reference</field>
        <field name="arch" type="xml">
            <form string="Referencia de Calzado">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" placeholder="Ej: REF-2026-X"/></h1>
                        <h2><field name="name" placeholder="Nombre del modelo"/></h2>
                    </div>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Insumos y Ficha Técnica">
                            <field name="material_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caramia_shoe_reference" model="ir.actions.act_window">
        <field name="name">Referencias de Calzado</field>
        <field name="res_model">caramia.shoe.reference</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_caramia_catalog_root" name="Calzado Cara Mia" sequence="10"/>
    <menuitem id="menu_caramia_shoe_reference" name="Referencias" parent="menu_caramia_catalog_root" action="action_caramia_shoe_reference"/>
</odoo>
