<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_caramia_customer_form" model="ir.ui.view">
        <field name="name">cara.mia.cliente.form</field>
        <field name="model">cara.mia.cliente</field>
        <field name="arch" type="xml">
            <form string="Cliente">
                <sheet>
                    <div class="oe_title">
                        <label for="cliente_id" string="ID Cliente"/>
                        <h1>
                            <field name="cliente_id" readonly="1"/>
                        </h1>
                        <label for="nombre_cliente" string="Nombre / Razón Social"/>
                        <h2>
                            <field name="nombre_cliente" placeholder="Nombre completo del cliente" required="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="telefono_cliente" string="Teléfono"/>
                            <field name="direccion" string="Dirección"/>
                        </group>
                        <group>
                            <field name="sello" string="Sello / Marca"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_caramia_customer_list" model="ir.ui.view">
        <field name="name">cara.mia.cliente.list</field>
        <field name="model">cara.mia.cliente</field>
        <field name="arch" type="xml">
            <list string="Clientes">
                <field name="cliente_id"/>
                <field name="nombre_cliente"/>
                <field name="direccion"/>
                <field name="telefono_cliente"/>
                <field name="sello"/>
            </list>
        </field>
    </record>

    <record id="view_caramia_customer_search" model="ir.ui.view">
        <field name="name">cara.mia.cliente.search</field>
        <field name="model">cara.mia.cliente</field>
        <field name="arch" type="xml">
            <search string="Buscar Clientes">
                <field name="cliente_id"/>
                <field name="nombre_cliente"/>
                <field name="direccion"/>
                <field name="telefono_cliente"/>
                <field name="sello"/>
            </search>
        </field>
    </record>

    <record id="action_caramia_customer" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">cara.mia.cliente</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrar primer cliente
            </p>
        </field>
    </record>

    <menuitem id="menu_caramia_customer_root"
              name="Clientes"
              sequence="10"/>

    <menuitem id="menu_caramia_customer_list"
              name="Lista de Clientes"
              parent="menu_caramia_customer_root"
              action="action_caramia_customer"
              sequence="10"/>
</odoo>