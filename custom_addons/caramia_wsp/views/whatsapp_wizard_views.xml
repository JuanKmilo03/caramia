<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VISTA FORMULARIO DEL WIZARD -->
    <record id="view_cara_mia_whatsapp_wizard_form" model="ir.ui.view">
        <field name="name">cara.mia.whatsapp.wizard.form</field>
        <field name="model">cara.mia.whatsapp.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar Recordatorios de Cobro por WhatsApp">
                <p class="text-muted">
                    Seleccione los clientes a los que desea enviar el recordatorio de cobro en este lote:
                </p>
                <sheet>
                    <field name="linea_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="enviar" widget="boolean_toggle"/>
                            <field name="cuenta_id"/>
                            <field name="cliente_id"/>
                            <field name="telefono"/>
                            <field name="fecha_vencimiento"/>
                            <field name="saldo_pendiente" widget="monetary"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_enviar_recordatorios" string="Enviar Mensajes Seleccionados" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ACCIÓN PARA ABRIR EL WIZARD -->
    <record id="action_cara_mia_whatsapp_wizard" model="ir.actions.act_window">
        <field name="name">Enviar Recordatorios WhatsApp</field>
        <field name="res_model">cara.mia.whatsapp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>