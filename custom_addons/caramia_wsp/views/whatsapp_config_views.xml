<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cara_mia_whatsapp_config_form" model="ir.ui.view">
        <field name="name">cara.mia.whatsapp.config.form</field>
        <field name="model">cara.mia.whatsapp.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de WhatsApp">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: Z-API / Evolution"/></h1>
                    </div>
                    <group>
                        <field name="proveedor"/>
                        <field name="api_url" placeholder="https://api.z-api.io/..."/>
                        <field name="api_token" password="True" placeholder="Token o API Key secreta..."/>
                        <field name="activo" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cara_mia_whatsapp_config_list" model="ir.ui.view">
        <field name="name">cara.mia.whatsapp.config.list</field>
        <field name="model">cara.mia.whatsapp.config</field>
        <field name="arch" type="xml">
            <list string="Configuraciones de WhatsApp">
                <field name="name"/>
                <field name="proveedor"/>
                <field name="api_url"/>
                <field name="activo" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_cara_mia_whatsapp_config" model="ir.actions.act_window">
        <field name="name">Configuración WhatsApp</field>
        <field name="res_model">cara.mia.whatsapp.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>