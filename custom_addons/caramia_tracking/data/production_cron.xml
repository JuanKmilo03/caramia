<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_production_estancadas" model="ir.cron">
        <field name="name">Producción: detectar órdenes estancadas</field>
        <field name="model_id" ref="caramia_production.model_cara_mia_produccion"/>
        <field name="state">code</field>
        <field name="code">model._cron_actualizar_estancadas()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="param_dias_borrador" model="ir.config_parameter">
        <field name="key">caramia_production.dias_borrador</field>
        <field name="value">3</field>
    </record>
    <record id="param_dias_etapa" model="ir.config_parameter">
        <field name="key">caramia_production.dias_etapa</field>
        <field name="value">7</field>
    </record>
</odoo>
