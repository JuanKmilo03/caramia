<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. La Acción de Cliente -->
    <record id="action_caramia_dashboard" model="ir.actions.client">
        <field name="name">Dashboard de Operaciones</field>
        <field name="tag">caramia_dashboard_action</field> <!-- Coincide con la etiqueta registrada en JS -->
    </record>

    <!-- 2. El Menú Principal -->
    <menuitem id="menu_caramia_root"
              name="Cara Mía"
              web_icon="caramia_tracking,static/description/icon.png"
              sequence="1"/>

    <!-- 3. Submenú enlazado al Dashboard -->
    <menuitem id="menu_caramia_dashboard"
              name="Panel Principal"
              parent="menu_caramia_root"
              action="action_caramia_dashboard"
              sequence="10"/>
</odoo>