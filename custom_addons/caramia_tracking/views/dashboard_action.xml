<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción real del dashboard de seguimiento -->
    <record id="action_caramia_dashboard" model="ir.actions.client">
        <field name="name">Resumen de operación</field>
        <field name="tag">caramia_tracking.stats</field>
    </record>

    <!-- Menú raíz: primera app => pestaña de inicio por defecto -->
    <menuitem id="menu_caramia_root"
              name="Inicio"
              web_icon="caramia_tracking,static/src/img/home.svg"
              sequence="1"/>

    <menuitem id="menu_caramia_dashboard"
              name="Resumen de operación"
              parent="menu_caramia_root"
              action="action_caramia_dashboard"
              sequence="1"
              groups="caramia_tracking.group_production_tracking"/>
</odoo>
