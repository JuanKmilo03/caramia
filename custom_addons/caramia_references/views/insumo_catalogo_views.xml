<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VISTA LIST (LISTA) -->
    <record id="view_cara_mia_insumo_catalogo_list" model="ir.ui.view">
        <field name="name">cara.mia.insumo.catalogo.list</field>
        <field name="model">cara.mia.insumo.catalogo</field>
        <field name="arch" type="xml">
            <list string="Catálogo General de Insumos" 
                  decoration-danger="stock_actual &lt;= 0"
                  decoration-warning="stock_actual &lt;= stock_minimo and stock_actual &gt; 0">
                <field name="name"/>
                <field name="tipo_componente_id"/>
                <field name="unidad_medida"/>
                <field name="costo_referencia"/>
                <field name="stock_actual" sum="Total Stock"/>
                <field name="stock_minimo"/>
            </list>
        </field>
    </record>

    <!-- VISTA FORM -->
    <record id="view_cara_mia_insumo_catalogo_form" model="ir.ui.view">
        <field name="name">cara.mia.insumo.catalogo.form</field>
        <field name="model">cara.mia.insumo.catalogo</field>
        <field name="arch" type="xml">
            <form string="Insumo del Catálogo">
                <sheet>
                    <group>
                        <group string="Información General">
                            <field name="name"/>
                            <field name="tipo_componente_id"
                                   options="{'no_create_edit': True, 'no_open': True}"/>
                        </group>
                        <group string="Costos y Medidas">
                            <field name="unidad_medida"/>
                            <field name="costo_referencia"/>
                        </group>
                        <group string="Control de Inventario">
                            <field name="stock_actual" readonly="1" force_save="1"
                                   style="font-size: 18px; font-weight: bold; color: #2e7d32;"/>
                            <field name="stock_minimo"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historial de Entradas (Compras)">
                            <field name="entrada_ids">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="cantidad"/>
                                    <field name="referencia_factura"/>
                                    <field name="observaciones"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACCIÓN DE VENTANA -->
    <record id="action_cara_mia_insumo_catalogo" model="ir.actions.act_window">
        <field name="name">Catálogo de Insumos</field>
        <field name="res_model">cara.mia.insumo.catalogo</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENÚ -->
    <menuitem id="menu_cara_mia_insumo_catalogo"
        name="Insumos y Materiales"
        parent="menu_cara_mia_root"
        action="action_cara_mia_insumo_catalogo"
        sequence="20"/>

</odoo>