<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cara_mia_referencia_form" model="ir.ui.view">
        <field name="name">cara.mia.referencia.form</field>
        <field name="model">cara.mia.referencia</field>
        <field name="arch" type="xml">
            <form string="Ficha Técnica de Calzado">
                <sheet>
                    <field name="imagen_zapato" widget="image" class="oe_avatar"
                        style="width: 120px; height: 120px;" />
                    <div class="oe_title">
                        <h1>
                            <field name="nombre_modelo"
                                placeholder="Nombre del Modelo (ej. Botín Casual)" />
                        </h1>
                        <h3>
                            <field name="codigo_referencia" placeholder="Código de referencia" />
                        </h3>
                    </div>
                    <group>
                    </group>
                    <notebook>
                        <page string="Lista de Materiales e Insumos" name="insumos_page">
                                <group>
                                    <field name="costo_total_insumos" readonly="1" widget="monetary" />
                                    <field name="costo_total_produccion" readonly="1"
                                        widget="monetary" />
                                </group>
                                <field name="insumo_ids">
                                    <list editable="bottom">
                                        <field name="insumo_catalogo_id" />
                                        <field name="tipo_componente" />
                                        <field name="cantidad" />
                                        <field name="unidad_medida" />
                                        <field name="costo_estimado" widget="monetary" />
                                    </list>
                                </field>
                        </page>
                        <page string="Descripción" name="desc_page">
                            <field name="descripcion"
                                placeholder="Indicaciones adicionales sobre el diseño o proceso de armado." />
                        </page>
                        <page string="Labores y Costos de Mano de Obra" name="labores_page">
                            <group>
                                <field name="precio_total_labor" readonly="1" widget="monetary" />
                            </group>
                            <field name="labor_ids">
                                <list editable="bottom">
                                    <field name="tipo_labor" />
                                    <field name="tarifa_pago" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cara_mia_referencia_list" model="ir.ui.view">
        <field name="name">cara.mia.referencia.list</field>
        <field name="model">cara.mia.referencia</field>
        <field name="arch" type="xml">
            <list string="Catálogo de Referencias">
                <field name="codigo_referencia" />
                <field name="nombre_modelo" />
                <field name="estado" />
            </list>
        </field>
    </record>

    <record id="action_cara_mia_referencia" model="ir.actions.act_window">
        <field name="name">Gestión de Referencias</field>
        <field name="res_model">cara.mia.referencia</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cara_mia_root" name="Calzado Cara Mía" sequence="10" />
    <menuitem id="menu_cara_mia_referencias" name="Referencias y Fichas" parent="menu_cara_mia_root"
        action="action_cara_mia_referencia" sequence="10" />
</odoo>