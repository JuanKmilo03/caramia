<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cuenta_cobro_form" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.cobro.form</field>
        <field name="model">cara.mia.cuenta.cobro</field>
        <field name="arch" type="xml">
            <form string="Cuenta de Cobro" create="0" class="o_caramia_cxc_form">
                <header>
                    <button name="action_registrar_pago" string="Registrar Abono / Pago"
                        type="object"
                        class="oe_highlight" invisible="estado not in ('vigente', 'vencida')" />
                    <button name="action_anular" string="Anular Cuenta" type="object"
                        class="btn-danger"
                        invisible="estado not in ('vigente', 'vencida')" />
                    <button name="action_enviar_recordatorio_whatsapp"
                        string="Recordatorio WhatsApp" type="object"
                        icon="fa-whatsapp"
                        invisible="estado not in ('vigente', 'vencida') or saldo_pendiente &lt;= 0" />
                    <field name="estado" widget="statusbar"
                        statusbar_visible="vigente,vencida,saldada" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Anulada" bg_color="text-bg-danger"
                        invisible="estado != 'anulada'" />
                    <widget name="web_ribbon" title="Saldada" bg_color="text-bg-success"
                        invisible="estado != 'saldada'" />
                    <field name="currency_id" invisible="1" />
                    <field name="alerta_cobro" invisible="1" />

                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_factura" type="object" class="oe_stat_button"
                            icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Ver Factura</span>
                            </div>
                        </button>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="not alerta_cobro">
                        <strong>Cuenta en alerta:</strong> lleva <field name="dias_sin_abono"
                            nolabel="1" class="d-inline" /> días sin abonos. </div>

                    <div class="oe_title">
                        <label for="name" string="CUENTA DE COBRO" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Datos del Cliente">
                            <field name="cliente_id" />
                            <field name="factura_id" />
                            <field name="ordenes_asociadas" />
                            <field name="forma_pago" />
                        </group>
                        <group string="Saldos y Fechas">
                            <field name="fecha_facturacion" />
                            <field name="fecha_vencimiento" />
                            <field name="monto_total" widget="monetary" />
                            <field name="total_abonado" widget="monetary" />
                            <field name="saldo_pendiente" widget="monetary"
                                class="fw-bold fs-4 text-danger" />
                            <field name="fecha_ultimo_pago" />
                        </group>
                    </group>
                    <group string="Anulación" invisible="estado != 'anulada'">
                        <field name="motivo_anulacion" />
                        <field name="fecha_anulacion" />
                        <field name="usuario_anulacion_id" />
                    </group>
                    <group string="Recordatorio WhatsApp"
                        invisible="estado not in ('vigente', 'vencida')">
                        <field name="fecha_recordatorio_wa" />
                        <field name="recordatorio_wa_estado" />
                    </group>
                    <notebook>
                        <page string="Pagos y Abonos">
                            <field name="pago_ids" readonly="1">
                                <list>
                                    <field name="fecha" />
                                    <field name="tipo" widget="badge" />
                                    <field name="monto" sum="Total abonado" widget="monetary" />
                                    <field name="metodo" />
                                    <field name="referencia" />
                                    <field name="observacion" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones">
                            <field name="observaciones"
                                placeholder="Notas sobre esta cuenta de cobro…" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_cuenta_cobro_list" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.cobro.list</field>
        <field name="model">cara.mia.cuenta.cobro</field>
        <field name="arch" type="xml">
            <list string="Cuentas por Cobrar" class="o_cam_facturacion_list caramia_facturacion_list"
                limit="1000" create="0"
                decoration-danger="estado == 'vencida'" decoration-warning="alerta_cobro">
                <field name="name" />
                <field name="cliente_id" />
                <field name="fecha_facturacion" optional="hide" />
                <field name="fecha_vencimiento" />
                <field name="forma_pago" optional="hide" />
                <field name="monto_total" sum="Total general" widget="monetary" />
                <field name="total_abonado" sum="Total abonado" widget="monetary" />
                <field name="saldo_pendiente" sum="Saldo pendiente" widget="monetary"
                    decoration-bf="1" />
                <field name="dias_sin_abono" optional="show" />
                <field name="fecha_recordatorio_wa" optional="hide" />
                <field name="alerta_cobro" column_invisible="1" />
                <field name="estado" widget="badge" decoration-danger="estado == 'vencida'"
                    decoration-info="estado == 'vigente'" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_cuenta_cobro_kanban" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.cobro.kanban</field>
        <field name="model">cara.mia.cuenta.cobro</field>
        <field name="arch" type="xml">
            <kanban class="caramia_facturacion_kanban"
                    default_group_by="estado"
                    group_create="false"
                    groups_draggable="false"
                    records_draggable="true"
                    quick_create="false"
                    limit="30">
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="saldo_pendiente"/>
                <field name="fecha_vencimiento"/>
                <field name="estado"/>
                <field name="alerta_cobro"/>
                <field name="currency_id" invisible="1"/>

                <templates>
                    <t t-name="card">
                        <div class="caramia-card">
                            <div class="caramia-card__top">
                                <span class="caramia-card__code" t-out="record.name.value"/>
                                <span t-if="record.alerta_cobro.raw_value" class="caramia-pill">
                                    Sin abonos
                                </span>
                            </div>
                            <div class="caramia-card__client" t-out="record.cliente_id.value"/>
                            <div class="caramia-card__ref" t-out="record.saldo_pendiente.value"/>
                            <div class="caramia-card__foot">
                                <span class="caramia-card__pairs">
                                    <span class="caramia-card__date" t-out="record.fecha_vencimiento.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cuenta_cobro_historial_list" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.cobro.historial.list</field>
        <field name="model">cara.mia.cuenta.cobro</field>
        <field name="arch" type="xml">
            <list string="Historial de Pagos" class="o_cam_facturacion_list caramia_facturacion_list"
                limit="1000" create="0"
                decoration-muted="estado == 'anulada'">
                <field name="name" />
                <field name="cliente_id" />
                <field name="fecha_ultimo_pago" />
                <field name="monto_total" sum="Total" widget="monetary" />
                <field name="total_abonado" sum="Abonado" widget="monetary" />
                <field name="saldo_pendiente" sum="Saldo" widget="monetary" />
                <field name="fecha_anulacion" optional="show" />
                <field name="motivo_anulacion" optional="hide" />
                <field name="estado" widget="badge" decoration-success="estado == 'saldada'"
                    decoration-danger="estado == 'anulada'" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_cuenta_cobro_pivot" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.cobro.pivot</field>
        <field name="model">cara.mia.cuenta.cobro</field>
        <field name="arch" type="xml">
            <pivot string="Cuentas por Cobrar">
                <field name="cliente_id" type="row" />
                <field name="monto_total" type="measure" />
                <field name="total_abonado" type="measure" />
                <field name="saldo_pendiente" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_cuenta_cobro_search" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.cobro.search</field>
        <field name="model">cara.mia.cuenta.cobro</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="N° Factura" />
                <field name="cliente_id" />
                <field name="observaciones" />
                <field name="saldo_pendiente" string="Saldo mayor o igual a"
                    filter_domain="[('saldo_pendiente', '&gt;=', self)]" />
                <filter name="f_vigente" string="Vigente" domain="[('estado', '=', 'vigente')]" />
                <filter name="f_vencida" string="Vencida" domain="[('estado', '=', 'vencida')]" />
                <filter name="f_saldada" string="Saldada" domain="[('estado', '=', 'saldada')]" />
                <filter name="f_anulada" string="Anulada" domain="[('estado', '=', 'anulada')]" />
                <separator />
                <filter name="con_saldo" string="Con saldo pendiente"
                    domain="[('saldo_pendiente', '&gt;', 0)]" />
                <filter name="f_alerta" string="En alerta (sin abonos)"
                    domain="[('alerta_cobro', '=', True)]" />
                <filter name="vence_semana" string="Vence en 7 días"
                    domain="[('fecha_vencimiento', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('fecha_vencimiento', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]" />
                <group expand="0" string="Agrupar por">
                    <filter name="g_cliente" string="Cliente" context="{'group_by': 'cliente_id'}" />
                    <filter name="g_estado" string="Estado" context="{'group_by': 'estado'}" />
                    <filter name="g_pago" string="Forma de pago"
                        context="{'group_by': 'forma_pago'}" />
                    <filter name="g_venc" string="Vencimiento (mes)"
                        context="{'group_by': 'fecha_vencimiento:month'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_cartera_cliente_search" model="ir.ui.view">
        <field name="name">cara.mia.cliente.cartera.search</field>
        <field name="model">cara.mia.cliente</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre_cliente" string="Cliente" />
                <field name="cliente_id" />
                <field name="sello" />
            </search>
        </field>
    </record>

    <record id="view_cartera_cliente_list" model="ir.ui.view">
        <field name="name">cara.mia.cliente.cartera.list</field>
        <field name="model">cara.mia.cliente</field>
        <field name="arch" type="xml">
            <list string="Saldos por Cliente" class="o_cam_facturacion_list caramia_facturacion_list"
                js_class="cartera_list"
                create="0" delete="0" import="0" default_order="nombre_cliente">
                <field name="cliente_id" string="ID Cliente" />
                <field name="nombre_cliente" string="Cliente" />
                <field name="total_facturado_cuentas" widget="monetary" sum="Total facturado" />
                <field name="total_abonado_cuentas" widget="monetary" sum="Total abonado" />
                <field name="saldo_pendiente_cuentas" widget="monetary" sum="Saldo total"
                    decoration-danger="saldo_pendiente_cuentas &gt; 0" decoration-bf="1" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_cartera_cliente_form" model="ir.ui.view">
        <field name="name">cara.mia.cliente.cartera.form</field>
        <field name="model">cara.mia.cliente</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Cartera del Cliente" create="0" delete="0" edit="0">
                <header>
                    <button name="action_registrar_abono" string="Registrar Abono" type="object"
                        class="oe_highlight" />
                </header>
                <sheet>
                    <field name="currency_id" invisible="1" />
                    <div class="oe_title mb-2">
                        <h1>
                            <field name="nombre_cliente" />
                        </h1>
                        <div class="text-muted">ID: <field name="cliente_id" class="d-inline" /></div>
                    </div>

                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <div class="card bg-danger-subtle text-danger-emphasis border-0 rounded-4"
                            style="min-width: 210px;">
                            <div class="card-body py-2 px-3">
                                <div class="small text-uppercase fw-semibold opacity-75">Saldo
                                    adeudado</div>
                                <div class="fs-3 fw-bold">
                                    <field name="saldo_pendiente_cuentas" widget="monetary" />
                                </div>
                            </div>
                        </div>
                        <div class="card bg-success-subtle text-success-emphasis border-0 rounded-4"
                            style="min-width: 210px;">
                            <div class="card-body py-2 px-3">
                                <div class="small text-uppercase fw-semibold opacity-75">Total
                                    abonado</div>
                                <div class="fs-3 fw-bold">
                                    <field name="total_abonado_cuentas" widget="monetary" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Facturas Activas">
                            <field name="cuenta_activa_ids" readonly="1">
                                <list decoration-danger="estado == 'vencida'">
                                    <field name="name" string="N° Factura" />
                                    <field name="fecha_facturacion" />
                                    <field name="fecha_vencimiento" />
                                    <field name="ordenes_asociadas" optional="hide" />
                                    <field name="monto_total" sum="Total" widget="monetary" />
                                    <field name="total_abonado" sum="Abonado" widget="monetary" />
                                    <field name="saldo_pendiente" sum="Saldo" widget="monetary"
                                        decoration-bf="1" />
                                    <field name="dias_sin_abono" optional="show" />
                                    <field name="estado" widget="badge"
                                        decoration-danger="estado == 'vencida'"
                                        decoration-info="estado == 'vigente'" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cara_mia_cuenta_anular_wizard_form" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.anular.wizard.form</field>
        <field name="model">cara.mia.cuenta.anular.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Anulación">
                <p class="text-danger"><strong>Atención:</strong> Al anular esta cuenta, la factura
                    cambiará a estado Anulada.</p>
                <group>
                    <field name="cuenta_id" readonly="1" />
                    <field name="motivo" required="1" />
                </group>
                <footer>
                    <button name="action_confirmar_anulacion" string="Anular" type="object"
                        class="btn-danger" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_saldos_clientes" model="ir.actions.act_window">
        <field name="name">Saldos por Cliente</field>
        <field name="res_model">cara.mia.cliente</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cuenta_cobro_ids.estado', 'in', ('vigente', 'vencida'))]</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="view_cartera_cliente_search" />
        <field name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('view_cartera_cliente_list')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('view_cartera_cliente_form')})]" />
    </record>

    <record id="action_cuentas_por_cobrar" model="ir.actions.act_window">
        <field name="name">Lista General de Cobros</field>
        <field name="res_model">cara.mia.cuenta.cobro</field>
        <field name="view_mode">kanban,list,pivot,form</field>
        <field name="domain">[('estado', 'in', ('vigente', 'vencida'))]</field>
        <field name="search_view_id" ref="view_cuenta_cobro_search" />
        <field name="view_ids"
            eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_cuenta_cobro_kanban')}),
        (0, 0, {'view_mode': 'list', 'view_id': ref('view_cuenta_cobro_list')}),
        (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_cuenta_cobro_pivot')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('view_cuenta_cobro_form')})]" />
    </record>

    <record id="action_historial_pagos" model="ir.actions.act_window">
        <field name="name">Historial de Pagos</field>
        <field name="res_model">cara.mia.cuenta.cobro</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('estado', 'in', ('saldada', 'anulada'))]</field>
        <field name="search_view_id" ref="view_cuenta_cobro_search" />
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_cuenta_cobro_historial_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_cuenta_cobro_form')})]" />
    </record>

    <record id="action_registrar_pago" model="ir.actions.act_window">
        <field name="name">Registrar pago múltiple</field>
        <field name="res_model">cara.mia.pago.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_registrar_pago_menu" name="Registrar Pago Múltiple"
        parent="menu_caramia_facturacion_root" action="action_registrar_pago" sequence="30" />

    <menuitem id="menu_saldos_clientes" name="Saldos por Cliente"
        parent="menu_cara_mia_cobros" action="action_saldos_clientes" sequence="10" />
    <menuitem id="menu_cuentas_por_cobrar" name="Lista General de Cobros"
        parent="menu_cara_mia_cobros" action="action_cuentas_por_cobrar" sequence="20" />
    <menuitem id="menu_historial_pagos" name="Historial de Pagos"
        parent="menu_cara_mia_cobros" action="action_historial_pagos" sequence="30" />

</odoo>