<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_caramia_cobros_settings_form" model="ir.ui.view">
        <field name="name">caramia.cobros.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Alertas y recordatorios de cartera">
                <sheet>
                    <div class="oe_title">
                        <h1>Alertas y recordatorios</h1>
                    </div>

                    <group string="Alertas internas de cartera">
                        <group>
                            <field name="caramia_dias_alerta_sin_abono" />
                            <field name="caramia_dias_reenvio_alerta" />
                            <field name="caramia_dias_aviso_vencimiento" />
                        </group>
                        <div class="text-muted small">
                            <p>Las alertas se publican en el chatter de la cuenta y se
                                asignan como actividad a los usuarios del grupo
                                <b>Alertas de Cobro</b>.</p>
                        </div>
                    </group>

                    <group string="Recordatorios por WhatsApp (Meta)">
                        <group>
                            <field name="caramia_wa_activo" />
                            <field name="caramia_wa_dias_gracia" />
                            <field name="caramia_wa_dias_reenvio" />
                            <field name="caramia_wa_api_version" />
                        </group>
                        <group>
                            <field name="caramia_wa_phone_id" />
                            <field name="caramia_wa_token" password="True" />
                            <field name="caramia_wa_template" />
                            <field name="caramia_wa_template_lang" />
                        </group>
                    </group>

                    <div class="text-muted small">
                        <p>El número se toma del campo <b>Teléfono</b> del cliente
                            (<code>telefono_cliente</code>). Si tiene 10 dígitos se le
                            antepone el indicativo 57.</p>
                        <p>Si define una plantilla, los parámetros del cuerpo deben ser,
                            en este orden: nombre del cliente, saldo, número de factura y
                            fecha de corte.</p>
                    </div>
                </sheet>
                <footer>
                    <button name="execute" string="Guardar" type="object" class="btn-primary" />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_caramia_cobros_settings" model="ir.actions.act_window">
        <field name="name">Configuración de cobros</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_caramia_cobros_settings_form" />
    </record>

    <menuitem id="menu_caramia_cobros_settings"
        name="Configuración de cobros"
        parent="menu_cara_mia_cobros"
        action="action_caramia_cobros_settings"
        groups="base.group_system"
        sequence="90" />

</odoo>
