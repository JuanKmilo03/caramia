<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORMULARIO -->
    <record id="view_caramia_facturacion_form" model="ir.ui.view">
        <field name="name">cara.mia.facturacion.form</field>
        <field name="model">cara.mia.facturacion</field>
        <field name="arch" type="xml">
            <form string="Remisión / Facturación">
                <header>
                    <button name="action_emitir" string="Emitir Remisión" type="object"
                        class="oe_highlight" invisible="estado != 'borrador'" />
                    <button name="action_imprimir_remision" string="Imprimir" type="object"
                        icon="fa-print" class="oe_highlight" invisible="estado == 'borrador'" />
                    <button name="action_anular" string="Anular Factura" type="object"
                        class="btn-danger" invisible="estado in ['borrador', 'anulada']"
                        confirm="¿Está seguro de que desea anular esta factura de forma definitiva? Las órdenes quedarán liberadas." />
                    <field name="estado" widget="statusbar"
                        statusbar_visible="borrador,emitida,pagada" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_cuenta_cobro" type="object" class="oe_stat_button"
                            icon="fa-money" string="Cuenta de Cobro"
                            invisible="estado == 'borrador'" />
                    </div>
                    <field name="currency_id" invisible="1" />
                    <h2 class="text-primary">Remisión <field name="name" class="oe_inline"
                            readonly="1" /></h2>
                    <group>
                        <group>
                            <field name="cliente_id" placeholder="Seleccione el Cliente..."
                                readonly="estado != 'borrador'" />
                            <field name="cliente_identificador" />
                            <field name="cliente_telefono" />
                        </group>
                        <group>
                            <field name="fecha_facturacion" readonly="estado != 'borrador'" />
                            <field name="forma_pago" readonly="estado != 'borrador'" />
                            <field name="fecha_vencimiento" readonly="estado != 'borrador'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Órdenes de Producción">
                            <field name="linea_ids" readonly="estado != 'borrador'">
                                <list editable="bottom">
                                    <field name="produccion_id"
                                        domain="[('cliente_id', '=', parent.cliente_id), ('state', '=', 'done'), ('factura_id', '=', False)]"
                                        options="{'no_create': True}" />
                                    <field name="descripcion" />
                                    <field name="cantidad" />
                                    <field name="valor_unitario" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_pares" class="oe_subtotal_footer_separator"/>
                                <field name="total_general" class="oe_subtotal_footer_separator"
                                    widget="monetary" />
                                <field name="saldo_pendiente"
                                    class="oe_subtotal_footer_separator text-danger"
                                    widget="monetary" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- LISTA -->
    <record id="view_caramia_facturacion_list" model="ir.ui.view">
        <field name="name">cara.mia.facturacion.list</field>
        <field name="model">cara.mia.facturacion</field>
        <field name="arch" type="xml">
            <list string="Remisiones" class="o_cam_facturacion_list caramia_facturacion_list"
                decoration-info="estado == 'borrador'"
                decoration-success="estado == 'pagada'" decoration-muted="estado == 'anulada'">
                <field name="name" string="N° Factura" />
                <field name="cliente_id" />
                <field name="fecha_facturacion" />
                <field name="fecha_vencimiento" />
                <field name="forma_pago" optional="hide" />
                <field name="total_general" string="Valor Total" widget="monetary" sum="Total" />
                <field name="saldo_pendiente" widget="monetary" sum="Saldo" optional="show" />
                <field name="estado" widget="badge" decoration-info="estado == 'borrador'"
                    decoration-primary="estado == 'emitida'" decoration-success="estado == 'pagada'"
                    decoration-danger="estado == 'anulada'" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <!-- BUSCADOR -->
    <record id="view_caramia_facturacion_search" model="ir.ui.view">
        <field name="name">cara.mia.facturacion.search</field>
        <field name="model">cara.mia.facturacion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="N° Factura" />
                <field name="cliente_id" />
                <filter name="f_borrador" string="Borrador" domain="[('estado', '=', 'borrador')]" />
                <filter name="f_emitida" string="Emitida" domain="[('estado', '=', 'emitida')]" />
                <filter name="f_pagada" string="Pagada" domain="[('estado', '=', 'pagada')]" />
                <filter name="f_anulada" string="Anulada" domain="[('estado', '=', 'anulada')]" />
                <group expand="0" string="Agrupar por">
                    <filter name="g_cliente" string="Cliente" context="{'group_by': 'cliente_id'}" />
                    <filter name="g_estado" string="Estado" context="{'group_by': 'estado'}" />
                    <filter name="g_mes" string="Mes de facturación"
                        context="{'group_by': 'fecha_facturacion:month'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- HERENCIA EN PRODUCCIÓN -->
    <record id="view_produccion_formulario_inherit_factura" model="ir.ui.view">
        <field name="name">cara.mia.produccion.form.inherit</field>
        <field name="model">cara.mia.produccion</field>
        <field name="inherit_id" ref="caramia_production.view_caramia_production_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='material']" position="after">
                <field name="factura_id" string="Factura N°" invisible="state != 'done'" />
            </xpath>
        </field>
    </record>

    <!-- ACCIÓN Y MENÚS PRINCIPALES -->
    <record id="action_caramia_facturacion" model="ir.actions.act_window">
        <field name="name">Remisiones y Facturación</field>
        <field name="res_model">cara.mia.facturacion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_caramia_facturacion_search" />
    </record>

    <menuitem id="menu_caramia_facturacion_root" name="Facturación" sequence="1" />
    <menuitem id="menu_caramia_facturacion_sub" name="Generar Remisión"
        parent="menu_caramia_facturacion_root" action="action_caramia_facturacion" sequence="10" />
    <menuitem id="menu_cara_mia_cobros" name="Cuentas por Cobrar"
        parent="menu_caramia_facturacion_root" sequence="20" />

</odoo>