    <!-- ======================================================= -->
    <!-- 3. VISTAS DE DETALLE DE CUENTAS DE COBRO               -->
    <!-- ======================================================= -->
    <record id="view_cara_mia_cuenta_cobro_form" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.cobro.form</field>
        <field name="model">cara.mia.cuenta.cobro</field>
        <field name="arch" type="xml">
            <form string="Cuenta de Cobro">
                <header>
                    <button name="action_registrar_pago" string="Registrar Abono / Pago"
                        type="object" class="oe_highlight"
                        invisible="estado in ['saldada', 'anulada']" />
                    <button name="action_anular" string="Anular Cuenta" type="object"
                        class="btn-danger" invisible="estado == 'anulada'" />
                    <field name="estado" widget="statusbar"
                        statusbar_visible="vigente,vencida,saldada,anulada" />
                </header>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_factura" type="object" class="oe_stat_button"
                            icon="fa-money" invisible="estado == 'borrador'">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="saldo_pendiente" />
                                </span>
                                <span class="o_stat_text">Saldo</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Datos del Cliente y Factura">
                            <field name="factura_id" readonly="1" />
                            <field name="cliente_id" readonly="1" />
                            <field name="fecha_facturacion" />
                            <field name="fecha_vencimiento" />
                        </group>
                        <group string="Saldos">
                            <field name="currency_id" invisible="1" />
                            <field name="monto_total" widget="monetary" />
                            <field name="total_abonado" widget="monetary" />
                            <field name="saldo_pendiente" widget="monetary"
                                class="oe_subtotal_footer_separator text-danger" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Historial de Abonos / Pagos">
                            <field name="pago_ids" readonly="1">
                                <list string="Abonos Registrados">
                                    <field name="fecha" />
                                    <field name="metodo" />
                                    <field name="referencia" />
                                    <field name="monto" widget="monetary" />
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones y Anulación"
                            invisible="not motivo_anulacion and not observaciones">
                            <group>
                                <field name="observaciones" />
                                <field name="motivo_anulacion" invisible="not motivo_anulacion" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_cara_mia_cuenta_cobro_historial_list" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.cobro.historial.list</field>
        <field name="model">cara.mia.cuenta.cobro</field>
        <field name="arch" type="xml">
            <list string="Historial de Pagos y Cuentas" create="false"
                decoration-success="estado == 'saldada'" decoration-muted="estado == 'anulada'">
                <field name="name" />
                <field name="factura_id" />
                <field name="cliente_id" />
                <field name="fecha_vencimiento" />
                <field name="monto_total" widget="monetary" />
                <field name="total_abonado" widget="monetary" />
                <field name="saldo_pendiente" widget="monetary" />
                <field name="estado" widget="badge" decoration-success="estado == 'saldada'"
                    decoration-muted="estado == 'anulada'" />
            </list>
        </field>
    </record>

    <!-- ======================================================= -->
    <!-- 4. WIZARDS                                             -->
    <!-- ======================================================= -->
    <record id="view_cara_mia_cuenta_anular_wizard_form" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.anular.wizard.form</field>
        <field name="model">cara.mia.cuenta.anular.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Anulación de Cuenta de Cobro">
                <p class="text-danger">
                    <strong>Atención:</strong> Al anular esta cuenta de cobro, la factura asociada
                    cambiará a estado Anulada. Debe justificar el motivo. </p>
                <group>
                    <field name="cuenta_id" readonly="1" />
                    <field name="motivo"
                        placeholder="Indique detalladamente la razón de anulación..." required="1" />
                </group>
                <footer>
                    <button name="action_confirmar_anulacion" string="Confirmar Anulación"
                        type="object" class="btn-danger" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_cara_mia_facturacion_linea_form" model="ir.ui.view">
        <field name="name">cara.mia.cuenta.cobro.pago.form</field>
        <field name="model">cara.mia.cuenta.cobro.pago</field>
        <field name="arch" type="xml">
            <form string="Registrar Abono o Pago">
                <group>
                    <group>
                        <field name="cuenta_id" readonly="1" />
                        <field name="fecha" />
                        <field name="monto" widget="monetary" />
                    </group>
                    <group>
                        <field name="metodo" />
                        <field name="referencia"
                            placeholder="Ej: N° Consignación o Transferencia" />
                    </group>
                </group>
                <footer>
                    <button string="Guardar Abono" class="btn-primary" special="save" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- ======================================================= -->
    <!-- 5. ACCIONES DE VENTANA                                  -->
    <!-- ======================================================= -->
    <record id="action_caramia_facturacion" model="ir.actions.act_window">
        <field name="name">Remisiones y Facturación</field>
        <field name="res_model">cara.mia.facturacion</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_caramia_facturacion_list" />
    </record>

