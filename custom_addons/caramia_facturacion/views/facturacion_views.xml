        <field name="name">Cuentas por Cobrar Activas</field>
        <field name="res_model">cara.mia.cliente.cartera.resumen</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_cara_mia_cliente_cartera_resumen_list" />
    </record> -->

    <record id="action_cara_mia_historial_pagos" model="ir.actions.act_window">
        <field name="name">Historial de Pagos</field>
        <field name="res_model">cara.mia.cuenta.cobro</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('estado', 'in', ['saldada', 'anulada'])]</field>
        <field name="view_id" ref="view_cara_mia_cuenta_cobro_historial_list" />
    </record>

    <!-- ======================================================= -->
    <!-- 6. MENÚ ÚNICO UNIFICADO DENTRO DE FACTURACIÓN          -->
    <!-- ======================================================= -->
    <menuitem id="menu_caramia_facturacion_root" name="Facturación" sequence="1" />

    <menuitem id="menu_caramia_facturacion_sub" name="Generar Remisión"
        parent="menu_caramia_facturacion_root" action="action_caramia_facturacion" sequence="10" />

    <menuitem id="menu_cara_mia_cobros" name="Cuentas por Cobrar"
        parent="menu_caramia_facturacion_root" sequence="20" />

    <menuitem id="menu_cara_mia_historial_pagos_item" name="Historial Pagos"
        parent="menu_cara_mia_cobros" action="action_cara_mia_historial_pagos" sequence="3" />

</odoo>