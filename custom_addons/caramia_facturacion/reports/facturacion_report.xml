<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_remision_doble" model="ir.actions.report">
        <field name="name">Imprimir Remisión (Doble)</field>
        <field name="model">cara.mia.facturacion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">caramia_facturacion.report_remision_template</field>
        <field name="report_file">caramia_facturacion.report_remision_template</field>
        <field name="binding_model_id" ref="model_cara_mia_facturacion"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_remision_template">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 11px;">
                    <t t-foreach="['Copia Cliente', 'Copia Administración']" t-as="tipo_copia">
                        <div style="border: 2px solid #000; padding: 15px; margin-bottom: 30px; page-break-inside: avoid;">
                            
                            <div class="row mb-3">
                                <div class="col-4">
                                    <h3 style="color: #ff66b2; font-style: italic;">Remisión</h3>
                                    <p class="mb-0"><strong>Fecha:</strong> <span t-field="doc.fecha_facturacion"/></p>
                                    <p class="mb-0"><strong>ID Cliente:</strong> <span t-field="doc.cliente_identificador"/></p>
                                    <p class="mb-0"><strong>Cliente:</strong> <span t-field="doc.cliente_id.nombre_cliente"/></p>
                                    <p class="mb-0"><strong>Dirección:</strong> <span t-field="doc.cliente_direccion"/></p>
                                    <p class="mb-0"><strong>Tel:</strong> <span t-field="doc.cliente_telefono"/></p>
                                </div>
                                <div class="col-4 text-center">
                                    <img t-if="doc.env.company.logo" t-att-src="image_data_uri(doc.env.company.logo)" style="max-height: 80px;" alt="Logo"/>
                                </div>
                                <div class="col-4">
                                    <p class="mb-0 text-end fw-bold text-muted" t-esc="tipo_copia"/>
                                    <div class="mt-2" style="border: 1px solid #000; padding: 5px;">
                                        <p class="mb-0"><strong>PEDIDO N°:</strong> <span t-field="doc.pedido_nro"/></p>
                                        <p class="mb-0"><strong>FORMA DE PAGO:</strong> <span t-field="doc.forma_pago"/></p>
                                        <p class="mb-0"><strong>FECHA VENCIMIENTO:</strong> <span t-field="doc.fecha_vencimiento"/></p>
                                        <p class="mb-0"><strong>N°:</strong> <span t-field="doc.name" class="fw-bold"/></p>
                                    </div>
                                </div>
                            </div>

                            <table class="table table-sm table-bordered border-dark text-center align-middle" style="font-size: 9px; width: 100%;">
                                <thead style="background-color: #ffccff;">
                                    <tr>
                                        <th>CÓDIGO</th>
                                        <th>DESCRIPCIÓN</th>
                                        <t t-foreach="range(21, 41)" t-as="t">
                                            <th t-esc="t"/>
                                        </t>
                                        <th>Cant</th>
                                        <th>Valor</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.linea_ids" t-as="linea">
                                        <tr>
                                            <td t-esc="linea.produccion_id.name"/>
                                            <td class="text-start" t-esc="linea.descripcion"/>
                                            <td t-esc="linea.talla_21"/><td t-esc="linea.talla_22"/><td t-esc="linea.talla_23"/>
                                            <td t-esc="linea.talla_24"/><td t-esc="linea.talla_25"/><td t-esc="linea.talla_26"/>
                                            <td t-esc="linea.talla_27"/><td t-esc="linea.talla_28"/><td t-esc="linea.talla_29"/>
                                            <td t-esc="linea.talla_30"/><td t-esc="linea.talla_31"/><td t-esc="linea.talla_32"/>
                                            <td t-esc="linea.talla_33"/><td t-esc="linea.talla_34"/><td t-esc="linea.talla_35"/>
                                            <td t-esc="linea.talla_36"/><td t-esc="linea.talla_37"/><td t-esc="linea.talla_38"/>
                                            <td t-esc="linea.talla_39"/><td t-esc="linea.talla_40"/>
                                            <td t-esc="linea.cantidad"/>
                                            <!-- Envolvemos los campos de moneda en un span -->
                                            <td><span t-field="linea.valor_unitario"/></td>
                                            <td><span t-field="linea.total_linea"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <div class="row mt-4">
                                <div class="col-8 d-flex align-items-end">
                                    <div style="width: 40%; margin-right: 20px;">
                                        <p class="mb-0 border-bottom border-dark">RECIBE:</p>
                                        <p class="mb-0 border-bottom border-dark mt-3">CC:</p>
                                    </div>
                                    <div style="width: 40%;">
                                        <p class="mb-0 border-bottom border-dark">ENTREGA:</p>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <table class="table table-sm table-bordered border-dark mb-0">
                                        <tr>
                                            <th style="background-color: #ffccff;" class="text-end">TOTAL</th>
                                            <!-- Envolvemos los campos de moneda en un span -->
                                            <td><span t-field="doc.total_general"/></td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #ffccff;" class="text-end">SALDO</th>
                                            <td><span t-field="doc.saldo_pendiente"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>