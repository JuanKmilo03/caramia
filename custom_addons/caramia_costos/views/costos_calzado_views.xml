<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_caramia_costo_number" model="ir.sequence">
        <field name="name">Secuencia de Costos Cara Mia</field>
        <field name="code">caramia.costo.number</field>
        <field name="prefix">COS-</field>
        <field name="padding">4</field>
    </record>

    <record id="view_caramia_costo_form" model="ir.ui.view">
        <field name="name">caramia.costo.form</field>
        <field name="model">caramia.costo</field>
        <field name="arch" type="xml">
            <form string="Cotización y Hoja de Costos">
                <header>
                    <button name="action_pass_to_production"
                        string="Pasar a Producción"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'" />
                    <button name="action_guardar_como_referencia"
                        class="fa-solid fa-floppy-disk"
                        string="Guardar Ficha Técnica"
                        type="object"
                        invisible="state not in ('draft', 'approved')" />
                    <button name="action_borrador"
                        string="Volver a Borrador"
                        type="object"
                        invisible="state != 'cancel'" />
                    <button name="action_actualizar_desde_referencia"
                        string="↺ Cargar Precios Iniciales"
                        type="object"
                        invisible="state not in ('draft', 'approved')" />
                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="draft,production" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>

                    <group col="3">
                        <group string="Información General">
                            <field name="referencia_id"
                                invisible="nombre_modelo != False and nombre_modelo != ''" />
                            <field name="nombre_modelo"
                                invisible="referencia_id != False"
                                placeholder="Escribe un modelo nuevo..." />
                            <field name="cliente_id" />
                            <field name="fecha" />
                            <field name="tipo_lote" />
                            <field name="cantidad_lote"
                                invisible="tipo_lote != 'custom'" />
                            <field name="currency_id" invisible="1" />
                            <field name="production_id"
                                readonly="1"
                                invisible="not production_id" />
                            <field name="observaciones" colspan="3"
                                placeholder="Notas / Observaciones..." />
                        </group>
                        <group string="Resumen de Costos">
                            <field name="total_materiales_par" />
                            <field name="total_labores_par" />
                            <field name="costo_total_par" />
                            <field name="costo_total_lote" />
                        </group>
                        <group string="">
                            <field name="precio_venta_par"
                                style="color: #2b78e4; font-weight: bold;" />
                            <field name="margen_ganancia"
                                style="color: #2b78e4; font-weight: bold;" />
                            <field name="precio_venta_lote"
                                style="color: #2b78e4; font-weight: bold;" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Materiales e Insumos">
                            <field name="material_ids"
                                readonly="state not in ('draft', 'approved')">
                                <list editable="bottom">
                                    <field name="insumo_catalogo_id"
                                        options="{'no_create': false, 'no_create_edit': false}" />
                                    <field name="tipo_componente_id"
                                        options="{'no_create': false, 'no_create_edit': false}" />
                                    <field name="unidad_medida" />
                                    <field name="cantidad_docena" />
                                    <field name="precio_unitario" widget="monetary" />
                                    <field name="costo_docena" widget="monetary" readonly="1" />
                                    <field name="cantidad_par" readonly="1" optional="show" />
                                    <field name="costo_par" widget="monetary" readonly="1"
                                        sum="Total Materiales / Par" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>

                        <page string="Mano de Obra / Labores">
                            <field name="labor_ids"
                                readonly="state not in ('draft', 'approved')">
                                <list editable="bottom">
                                    <field name="tipo_labor_id" />
                                    <field name="costo_par"
                                        sum="Total Labores / Par" />
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_caramia_costo_tree" model="ir.ui.view">
        <field name="name">caramia.costo.tree</field>
        <field name="model">caramia.costo</field>
        <field name="arch" type="xml">
            <list string="Costos de Calzado">
                <field name="name" />
                <field name="fecha" />
                <field name="referencia_id" />
                <field name="cliente_id" />
                <field name="cantidad_lote" />
                <field name="costo_total_par" sum="Total Costo Par" />
                <field name="costo_total_lote" sum="Total Costo Lote" />
                <field name="precio_venta_par" sum="Total Precio Venta Par" />
                <field name="margen_ganancia" sum="Total Margen" />
                <field name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'approved'"
                    decoration-success="state == 'production'"
                    decoration-danger="state == 'cancel'" />
            </list>
        </field>
    </record>

    <record id="action_caramia_costo" model="ir.actions.act_window">
        <field name="name">Hoja de Costos</field>
        <field name="res_model">caramia.costo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_caramia_costo_main"
        name="Costos"
        parent="caramia_production.menu_caramia_production_root"
        action="action_caramia_costo"
        sequence="15" />

</odoo>