<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_caramia_template">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-size: 10px; font-family: Arial, sans-serif;">
                    
                    <style>
                        @page {
                            margin: 0mm !important;
                        }
                        .page {
                            margin: 0 !important;
                            padding: 0 !important;
                        }
                        .table {
                            margin-bottom: 4px !important;
                        }
                    </style>

                    <!-- Encabezado con el cual el administrador de la fábrica se queda -->
                    <table class="table table-bordered mb-2">
                        <tr>
                            <td style="width: 45%; vertical-align: middle;">
                                <h4 class="m-0"><strong>ORDEN DE PRODUCCIÓN</strong></h4>
                                <strong>ORDEN N°: </strong> <span t-field="o.name"/><br/>
                                <strong>FECHA: </strong> <span t-field="o.date"/><br/>
                                <strong>CLIENTE: </strong> <span t-field="o.customer_id.name"/><br/>
                                <strong>REFERENCIA: </strong> <span t-field="o.referencia_id.display_name"/><br/>
                                <strong>SELLO: </strong> <span t-field="o.sello"/>
                            </td>
                            <td style="width: 25%; text-align: center; vertical-align: middle;">
                                <span t-if="o.imagen_zapato">
                                    <img t-att-src="image_data_uri(o.imagen_zapato)" style="max-height: 65px; max-width: 90px; border: 1px solid #ccc; padding: 2px; border-radius: 4px;"/>
                                </span>
                            </td>
                            <td style="width: 30%; text-align: center; vertical-align: middle;">
                                <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.name, 300, 50)" style="max-height: 40px;"/>
                                <div style="font-weight: bold; margin-top: 2px;" t-field="o.name"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Tiquets por labor segun la referencia del calzado -->
                    <t t-foreach="o.labor_ids" t-as="labor">
                        <div style="border: 1px dashed #000; padding: 4px; margin-bottom: 6px; page-break-inside: avoid;">

                            <table class="table table-bordered table-sm text-center m-0" style="font-size: 10px;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="background-color: #ffccff;"><strong>21</strong></th>
                                        <th><strong>22</strong></th>
                                        <th style="background-color: #ffccff;"><strong>23</strong></th>
                                        <th><strong>24</strong></th>
                                        <th style="background-color: #ffccff;"><strong>25</strong></th>
                                        <th><strong>26</strong></th>
                                        <th style="background-color: #ffccff;"><strong>27</strong></th>
                                        <th><strong>28</strong></th>
                                        <th style="background-color: #ffccff;"><strong>29</strong></th>
                                        <th><strong>30</strong></th>
                                        <th style="background-color: #ffccff;"><strong>31</strong></th>
                                        <th><strong>32</strong></th>
                                        <th style="background-color: #ffccff;"><strong>33</strong></th>
                                        <th><strong>34</strong></th>
                                        <th style="background-color: #ffccff;"><strong>35</strong></th>
                                        <th><strong>36</strong></th>
                                        <th style="background-color: #ffccff;"><strong>37</strong></th>
                                        <th><strong>38</strong></th>
                                        <th style="background-color: #ffccff;"><strong>39</strong></th>
                                        <th><strong>40</strong></th>
                                        <th><strong>TOTAL PARES</strong></th>
                                        <th><strong>REFERENCIA</strong></th>
                                        <th><strong>DESCRIPCIÓN</strong></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="background-color: #ffccff;"><span t-esc="o.talla_21 or ''"/></td>
                                        <td><span t-esc="o.talla_22 or ''"/></td>
                                        <td style="background-color: #ffccff;"><span t-esc="o.talla_23 or ''"/></td>
                                        <td><span t-esc="o.talla_24 or ''"/></td>
                                        <td style="background-color: #ffccff;"><span t-esc="o.talla_25 or ''"/></td>
                                        <td><span t-esc="o.talla_26 or ''"/></td>
                                        <td style="background-color: #ffccff;"><span t-esc="o.talla_27 or ''"/></td>
                                        <td><span t-esc="o.talla_28 or ''"/></td>
                                        <td style="background-color: #ffccff;"><span t-esc="o.talla_29 or ''"/></td>
                                        <td><span t-esc="o.talla_30 or ''"/></td>
                                        <td style="background-color: #ffccff;"><span t-esc="o.talla_31 or ''"/></td>
                                        <td><span t-esc="o.talla_32 or ''"/></td>
                                        <td style="background-color: #ffccff;"><span t-esc="o.talla_33 or ''"/></td>
                                        <td><span t-esc="o.talla_34 or ''"/></td>
                                        <td style="background-color: #ffccff;"><span t-esc="o.talla_35 or ''"/></td>
                                        <td><span t-esc="o.talla_36 or ''"/></td>
                                        <td style="background-color: #ffccff;"><span t-esc="o.talla_37 or ''"/></td>
                                        <td><span t-esc="o.talla_38 or ''"/></td>
                                        <td style="background-color: #ffccff;"><span t-esc="o.talla_39 or ''"/></td>
                                        <td><span t-esc="o.talla_40 or ''"/></td>
                                        <td><span t-field="o.total_pares"/></td>
                                        <td><span t-field="o.referencia_id.display_name"/></td>
                                        <td rowSpan="2"><span t-field="o.description"/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3"><strong>COLOR</strong></td>
                                        <td colspan="17"><span t-field="o.color"/></td>
                                        <td><strong>FECHA CREACIÓN</strong></td>
                                        <td><span t-field="o.date"/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3"><strong>MATERIAL</strong></td>
                                        <td colspan="17"><span t-field="o.material"/></td>
                                        <td><strong>ORDEN N°</strong></td>
                                        <td><span t-field="o.name"/></td>
                                        <td style="vertical-align: middle; padding: 0; margin: 0;" rowspan="2">
                                            <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.name, 300, 50)" style="max-height: 40px; max-width: 180px; padding: 0; margin: 0;"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="3"><strong>PRECIO</strong></td>
                                        <td colspan="10" style="background-color: #ffccff;"><span t-field="labor.tarifa_pago"/></td>
                                        <td colspan="7"><strong><span t-field="labor.tipo_labor"/></strong></td>
                                        <td><strong>SELLO</strong></td>
                                        <td style="background-color: #ffccff;"><span t-field="o.sello"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>

                </div>
            </t>
        </t>
    </template>
</odoo>