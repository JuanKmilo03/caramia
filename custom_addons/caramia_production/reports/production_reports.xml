<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_caramia_ticket" model="report.paperformat">
        <field name="name">Formato Ticket Producción (Sin Márgenes)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">4</field>
        <field name="margin_bottom">4</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_caramia_production" model="ir.actions.report">
        <field name="name">Orden de Producción</field>
        <field name="model">caramia.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">caramia_production.report_caramia_template</field>
        <field name="report_file">Orden_Produccion</field>
        <field name="print_report_name">'Orden_' + object.name</field>
        <field name="paperformat_id" ref="paperformat_caramia_ticket"/>
        <field name="binding_model_id" ref="model_caramia_production"/>
        <field name="binding_type">report</field>
    </record>
</odoo>