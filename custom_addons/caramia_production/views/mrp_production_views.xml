<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_caramia" model="ir.ui.view">
        <field name="name">mrp.production.form.caramia</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="caramia_client_id"/>
                <field name="shoe_reference_id"/>
                <field name="pairs_count"/>
                <field name="barcode_labor"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Ficha técnica Cara Mía">
                    <group>
                        <group>
                            <field name="shoe_last"/>
                            <field name="sole_specification"/>
                        </group>
                        <group>
                            <field name="pairs_count" readonly="1"/>
                            <field name="total_pairs_by_size" readonly="1"/>
                        </group>
                    </group>
                    <group string="Cantidades por talla">
                        <field name="size_line_ids">
                            <list editable="bottom">
                                <field name="size"/>
                                <field name="pairs_qty"/>
                            </list>
                        </field>
                    </group>
                    <group string="Especificaciones adicionales">
                        <field name="technical_notes" nolabel="1"
                               placeholder="Materiales, colores, acabados u otras instrucciones del pedido..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_caramia_client_production_history" model="ir.ui.view">
        <field name="name">res.partner.form.caramia.production.history</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="caramia_invoicing.view_caramia_client_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='caramia_client_sections']" position="after">
                <group string="Historial de órdenes de producción">
                    <field name="production_order_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="shoe_reference_id"/>
                            <field name="pairs_count"/>
                            <field name="total_pairs_by_size"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
