<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista exclusiva para la gestión de clientes de Cara Mia. -->
    <record id="view_caramia_client_form" model="ir.ui.view">
        <field name="name">res.partner.form.caramia.client</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Cliente">
                <sheet class="caramia_client_form">
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre del cliente"/>
                        </h1>
                        <field name="company_type" widget="radio" options="{'horizontal': true}"/>
                    </div>
                    <field name="is_caramia_client" invisible="1"/>
                    <field name="customer_rank" invisible="1"/>

                    <div class="caramia_client_sections">
                        <group>
                            <group string="Identificación" class="caramia_client_section">
                                <field name="vat" placeholder="Número de documento o NIT"/>
                                <field name="client_type"/>
                            </group>
                            <group string="Contacto" class="caramia_client_section">
                                <field name="phone" widget="phone"/>
                                <field name="email" widget="email"/>
                                <field name="website" widget="url"/>
                            </group>
                        </group>
                        <group>
                            <group string="Dirección" class="caramia_client_section">
                                <field name="street" placeholder="Dirección"/>
                                <field name="street2" placeholder="Complemento"/>
                                <field name="city"/>
                                <field name="state_id"/>
                                <field name="zip"/>
                                <field name="country_id"/>
                            </group>
                            <group string="Información comercial" class="caramia_client_section caramia_client_commercial">
                                <field name="credit_limit_custom"/>
                                <field name="preferred_transport"/>
                            </group>
                        </group>
                        <group string="Notas comerciales" class="caramia_client_section">
                            <field name="commercial_notes" nolabel="1"
                                   placeholder="Acuerdos de pago, descuentos y preferencias del cliente..."/>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_caramia_client_list" model="ir.ui.view">
        <field name="name">res.partner.list.caramia.client</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Clientes" class="caramia_client_list">
                <field name="image_128" widget="image" optional="hide"/>
                <field name="name"/>
                <field name="vat"/>
                <field name="client_type"/>
                <field name="phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="city" optional="hide"/>
                <field name="credit_limit_custom" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_caramia_client_kanban" model="ir.ui.view">
        <field name="name">res.partner.kanban.caramia.client</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="caramia_client_kanban" sample="1">
                <field name="name"/>
                <field name="image_128"/>
                <field name="client_type"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="city"/>
                <templates>
                    <t t-name="card">
                        <main class="d-flex">
                            <aside class="o_kanban_aside_full">
                                <field name="image_128" widget="image"
                                       options="{'preview_image': 'image_128'}"/>
                            </aside>
                            <div class="ms-3 flex-grow-1 overflow-hidden">
                                <strong class="d-block text-truncate">
                                    <field name="name"/>
                                </strong>
                                <span class="text-muted d-block" t-if="record.client_type.raw_value">
                                    <field name="client_type"/>
                                </span>
                                <span class="d-block text-truncate" t-if="record.phone.raw_value">
                                    <i class="fa fa-phone me-1" title="Teléfono"/><field name="phone"/>
                                </span>
                                <span class="d-block text-truncate" t-if="record.email.raw_value">
                                    <i class="fa fa-envelope me-1" title="Correo electrónico"/><field name="email"/>
                                </span>
                                <span class="d-block text-truncate" t-if="record.city.raw_value">
                                    <i class="fa fa-map-marker me-1" title="Ciudad"/><field name="city"/>
                                </span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_caramia_client_search" model="ir.ui.view">
        <field name="name">res.partner.search.caramia.client</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Buscar clientes">
                <field name="name"/>
                <field name="vat"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="client_type"/>
                <field name="city"/>
                <field name="country_id"/>
                <filter string="Empresas" name="companies" domain="[('is_company', '=', True)]"/>
                <filter string="Personas" name="persons" domain="[('is_company', '=', False)]"/>
                <separator/>
                <filter string="Mayoristas" name="wholesalers" domain="[('client_type', '=', 'wholesaler')]"/>
                <filter string="Tiendas" name="retailers" domain="[('client_type', '=', 'retailer')]"/>
                <filter string="Distribuidores" name="distributors" domain="[('client_type', '=', 'distributor')]"/>
                <filter string="Cliente final" name="final_customers" domain="[('client_type', '=', 'final')]"/>
                <group>
                    <filter string="Tipo de cliente" name="group_by_client_type" context="{'group_by': 'client_type'}"/>
                    <filter string="Ciudad" name="group_by_city" context="{'group_by': 'city'}"/>
                    <filter string="País" name="group_by_country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción con el dominio y valores por defecto que hacen del contacto un cliente. -->
    <record id="action_caramia_clients" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_caramia_client', '=', True)]</field>
        <field name="context">{'default_is_caramia_client': True, 'default_customer_rank': 1}</field>
        <field name="search_view_id" ref="view_caramia_client_search"/>
    </record>

    <record id="action_caramia_clients_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_caramia_client_kanban"/>
        <field name="act_window_id" ref="action_caramia_clients"/>
    </record>

    <record id="action_caramia_clients_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_caramia_client_list"/>
        <field name="act_window_id" ref="action_caramia_clients"/>
    </record>

    <record id="action_caramia_clients_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_caramia_client_form"/>
        <field name="act_window_id" ref="action_caramia_clients"/>
    </record>

    <menuitem id="menu_caramia_invoicing_root" name="Comercial y Facturación" sequence="20"/>
    <menuitem id="menu_caramia_clients" name="Clientes" parent="menu_caramia_invoicing_root"
              action="action_caramia_clients" sequence="10"/>
</odoo>
