<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== VISTAS DE CARGOS / PUESTOS ==================== -->
    <record id="view_caramia_employee_job_form" model="ir.ui.view">
        <field name="name">caramia.employee.job.form</field>
        <field name="model">caramia.employee.job</field>
        <field name="arch" type="xml">
            <form string="Cargo / Puesto">
                <sheet>
                    <group>
                        <field name="name" placeholder="Ej. Cortador, Guarnecedor, Montador" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_caramia_employee_job_list" model="ir.ui.view">
        <field name="name">caramia.employee.job.list</field>
        <field name="model">caramia.employee.job</field>
        <field name="arch" type="xml">
            <list string="Cargos / Puestos">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_caramia_employee_job" model="ir.actions.act_window">
        <field name="name">Cargos / Puestos</field>
        <field name="res_model">caramia.employee.job</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear el primer cargo de trabajo
            </p>
        </field>
    </record>

    <!-- ==================== VISTAS DE EMPLEADOS ==================== -->
    <record id="view_caramia_employee_form" model="ir.ui.view">
        <field name="name">caramia.employee.form</field>
        <field name="model">caramia.employee</field>
        <field name="arch" type="xml">
            <form string="Empleado">
                <sheet>
                    <div class="oe_title">
                        <label for="employee_code" string="ID EMPLEADO"/>
                        <h1>
                            <field name="employee_code" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="Ej. Juan Pérez" required="1"/>
                            <field name="job_id" placeholder="Seleccione un cargo..." required="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_caramia_employee_list" model="ir.ui.view">
        <field name="name">caramia.employee.list</field>
        <field name="model">caramia.employee</field>
        <field name="arch" type="xml">
            <list string="Empleados">
                <field name="employee_code"/>
                <field name="name"/>
                <field name="job_id"/>
            </list>
        </field>
    </record>

    <record id="view_caramia_employee_kanban" model="ir.ui.view">
        <field name="name">caramia.employee.kanban</field>
        <field name="model">caramia.employee</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge text-bg-primary fs-6">
                                    <field name="employee_code"/>
                                </span>
                            </div>
                            <div class="fw-bold fs-5 text-dark mb-1">
                                <field name="name"/>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-briefcase me-1"/>
                                <field name="job_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_caramia_employee_search" model="ir.ui.view">
        <field name="name">caramia.employee.search</field>
        <field name="model">caramia.employee</field>
        <field name="arch" type="xml">
            <search string="Buscar Empleados">
                <field name="employee_code"/>
                <field name="name"/>
                <field name="job_id"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cargo / Puesto" name="group_by_job" context="{'group_by': 'job_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_caramia_employee" model="ir.actions.act_window">
        <field name="name">Empleados</field>
        <field name="res_model">caramia.employee</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrar primer empleado
            </p>
        </field>
    </record>

    <!-- ==================== MENÚS ==================== -->
    <menuitem id="menu_caramia_employee_root"
              name="Empleados"
              sequence="20"/>

    <menuitem id="menu_caramia_employee_list"
              name="Lista de Empleados"
              parent="menu_caramia_employee_root"
              action="action_caramia_employee"
              sequence="10"/>

    <menuitem id="menu_caramia_employee_job_list"
              name="Cargos / Puestos"
              parent="menu_caramia_employee_root"
              action="action_caramia_employee_job"
              sequence="20"/>
</odoo>