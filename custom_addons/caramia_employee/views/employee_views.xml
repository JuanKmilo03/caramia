<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Personal data integrated in the standard employee form. -->
    <record id="view_employee_form_caramia" model="ir.ui.view">
        <field name="name">hr.employee.form.caramia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="attributes">
                <attribute name="class" add="caramia_employee_form" separator=" "/>
            </xpath>
            <!-- Los datos propios se muestran directamente en el formulario,
                 sin crear una pestana adicional. -->
            <xpath expr="//notebook" position="before">
                <div class="caramia_employee_personal_page">
                    <group>
                        <group string="Identificacion" class="caramia_employee_section">
                            <field name="document_type"/>
                            <field name="document_number"/>
                        </group>
                        <group string="Contacto" class="caramia_employee_section">
                            <field name="personal_phone" widget="phone"/>
                            <field name="personal_address"/>
                        </group>
                    </group>
                        <group string="Contacto de emergencia" class="caramia_employee_section caramia_employee_emergency">
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone" widget="phone"/>
                        </group>
                    <group string="Información de fábrica" class="caramia_employee_section">
                        <field name="factory_role_id"/>
                        <field name="factory_entry_date"/>
                        <field name="active"/>
                    </group>
                    <group string="Observaciones" class="caramia_employee_section">
                        <field name="personal_notes" placeholder="Anade informacion relevante para la gestion del empleado..." nolabel="1"/>
                    </group>
                </div>
            </xpath>
            <!-- Se elimina el notebook completo: Trabajo, Curriculum,
                 Personal, Nomina y Ajustes dejan de existir visualmente. -->
            <xpath expr="//notebook" position="replace"/>
        </field>
    </record>

    <!-- Keep the standard kanban view and attach the Cara Mia visual theme. -->
    <record id="view_employee_kanban_caramia" model="ir.ui.view">
        <field name="name">hr.employee.kanban.caramia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="class" add="caramia_employee_kanban" separator=" "/>
            </xpath>
        </field>
    </record>

    <!-- Clase propia para no afectar las listas de otros modulos. -->
    <record id="view_employee_list_caramia" model="ir.ui.view">
        <field name="name">hr.employee.list.caramia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class" add="caramia_employee_list" separator=" "/>
            </xpath>
        </field>
    </record>

    <record id="view_caramia_employee_role_list" model="ir.ui.view">
        <field name="name">caramia.employee.role.list</field>
        <field name="model">caramia.employee.role</field>
        <field name="arch" type="xml">
            <list string="Roles de fábrica">
                <field name="name"/>
                <field name="code"/>
                <field name="price_per_pair" widget="monetary"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_caramia_employee_role_form" model="ir.ui.view">
        <field name="name">caramia.employee.role.form</field>
        <field name="model">caramia.employee.role</field>
        <field name="arch" type="xml">
            <form string="Rol de fábrica">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_per_pair" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Observaciones"><field name="notes" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caramia_employee_roles" model="ir.actions.act_window">
        <field name="name">Roles de fábrica</field>
        <field name="res_model">caramia.employee.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_caramia_employee_root" name="Personal Cara Mía" sequence="14"/>
    <menuitem id="menu_caramia_employee_roles" name="Roles y tarifas" parent="menu_caramia_employee_root"
              action="action_caramia_employee_roles" sequence="20"/>
</odoo>
