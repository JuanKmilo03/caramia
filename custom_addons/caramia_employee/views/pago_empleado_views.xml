<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VISTA LISTA: Historial / Registro de Nóminas -->
    <record id="view_caramia_pago_empleado_list" model="ir.ui.view">
        <field name="name">cara.mia.pago.empleado.list</field>
        <field name="model">cara.mia.pago.empleado</field>
        <field name="arch" type="xml">
            <list string="Lista de Nóminas de Empleados">
                <field name="name" />
                <field name="fecha_nomina" />
                <field name="total_neto" widget="monetary" string="Total A Pagar" />
                <field name="total_pagado" widget="monetary" string="Total Pagado"
                    class="fw-bold text-success" />
                <field name="state" widget="badge"
                    decoration-success="state == 'done'"
                    decoration-info="state == 'in_progress'"
                    decoration-muted="state == 'draft'" />
            </list>
        </field>
    </record>

    <!-- VISTA BUSQUEDA / BUSCADOR PARA LÍNEAS DE EMPLEADOS -->
    <record id="view_caramia_pago_empleado_linea_search" model="ir.ui.view">
        <field name="name">cara.mia.pago.empleado.linea.search</field>
        <field name="model">cara.mia.pago.empleado.linea</field>
        <field name="arch" type="xml">
            <search string="Buscar Empleado en Nómina">
                <field name="empleado_id" string="Empleado" />
                <filter string="Pagados" name="filter_pagado" domain="[('pagado', '=', True)]" />
                <filter string="Pendientes de Pago" name="filter_pendiente"
                    domain="[('pagado', '=', False)]" />
                <separator />
                <filter string="Aplica Liquidación" name="filter_aplica_liq"
                    domain="[('aplica_liquidacion', '=', True)]" />
                <filter string="No Aplica Liquidación" name="filter_no_aplica_liq"
                    domain="[('aplica_liquidacion', '=', False)]" />
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado de Pago" name="group_pagado"
                        context="{'group_by': 'pagado'}" />
                    <filter string="Aplica Liquidación" name="group_aplica_liq"
                        context="{'group_by': 'aplica_liquidacion'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- VISTA LISTA DE LÍNEAS (PARA CUANDO SE ABRE CON EL SMART BUTTON) -->
    <record id="view_caramia_pago_empleado_linea_list" model="ir.ui.view">
        <field name="name">cara.mia.pago.empleado.linea.list</field>
        <field name="model">cara.mia.pago.empleado.linea</field>
        <field name="arch" type="xml">
            <list string="Detalle de Empleados en Nómina" editable="bottom" create="false">
                <field name="empleado_id" readonly="1" />
                <field name="aplica_liquidacion" string="Aplica Liq." widget="boolean_toggle" />
                <field name="total_pares" readonly="1" />
                <field name="monto_bruto" widget="monetary" string="Bruto Labores" readonly="1" />
                <field name="reserva" widget="monetary" string="Reserva Liq. (0.22%)"
                    class="text-warning" readonly="1" />
                <field name="monto_neto" widget="monetary" string="Valor a Pagar" class="fw-bold"
                    readonly="1" />
                <field name="pagado" string="¿Pagado?" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- VISTA BUSQUEDA GENERAL DE REGISTROS DE NÓMINAS -->
    <record id="view_caramia_pago_empleado_search" model="ir.ui.view">
        <field name="name">cara.mia.pago.empleado.search</field>
        <field name="model">cara.mia.pago.empleado</field>
        <field name="arch" type="xml">
            <search string="Buscar Nóminas">
                <field name="name" />
                <field name="fecha_nomina" />
                <filter string="Borradores" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="En Proceso" name="in_progress"
                    domain="[('state', '=', 'in_progress')]" />
                <filter string="Finalizados" name="done" domain="[('state', '=', 'done')]" />
            </search>
        </field>
    </record>

    <!-- VISTA FORMULARIO PRINCIPAL DE NÓMINA -->
    <record id="view_caramia_pago_empleado_form" model="ir.ui.view">
        <field name="name">cara.mia.pago.empleado.form</field>
        <field name="model">cara.mia.pago.empleado</field>
        <field name="arch" type="xml">
            <form string="Nómina de Empleados">
                <header>
                    <button name="action_calcular_pagos"
                        string="Calcular Pagos"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ['draft', 'in_progress']" />

                    <button name="action_confirmar_pago"
                        string="Aprobar y Finalizar"
                        type="object"
                        class="btn-success"
                        invisible="state != 'in_progress'"
                        confirm="¿Está seguro de procesar esta liquidación? Se verificará que todos los empleados de la lista estén marcados como pagados." />

                    <button name="action_imprimir_nomina"
                        string="Imprimir Nómina"
                        type="object"
                        class="btn-primary"
                        invisible="state == 'draft'" />

                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,in_progress,done" />
                </header>
                <sheet>
                    <!-- BOTÓN DE BÚSQUEDA INTERACTIVA (SMART BUTTON) -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_lineas"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users"
                            invisible="state == 'draft'">
                            <field name="cantidad_lineas" widget="statinfo"
                                string="Buscar / Filtrar" />
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>

                    <group>
                        <group string="Período a Pagar">
                            <field name="fecha_inicio" readonly="state == 'done'" />
                            <field name="fecha_fin" readonly="state == 'done'" />
                        </group>
                        <group string="Resumen General">
                            <field name="fecha_nomina" />
                            <field name="currency_id" invisible="1" />
                            <field name="total_neto" widget="monetary" string="Total A Pagar"
                                class="fw-bold" />
                            <field name="total_pagado" widget="monetary" string="Valor Pagado"
                                class="fw-bold text-success fs-4" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Lista de Empleados y Pagos">
                            <field name="linea_ids" readonly="state == 'done'">
                                <list editable="bottom" create="false" delete="state != 'done'">
                                    <field name="empleado_id" readonly="1" />
                                    <field name="aplica_liquidacion" string="Aplica Liq." />
                                    <field name="total_pares" readonly="1" />
                                    <field name="monto_bruto" widget="monetary"
                                        string="Bruto Labores" readonly="1" />
                                    <field name="reserva" widget="monetary"
                                        string="Reserva Liq. (0.22%)" class="text-warning" />
                                    <field name="monto_neto" widget="monetary"
                                        string="Valor a Pagar" class="fw-bold" />
                                    <field name="pagado" string="¿Pagado?" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

</odoo>