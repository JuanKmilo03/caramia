<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Formulario -->
    <record id="view_caramia_registro_trabajo_orden_form" model="ir.ui.view">
        <field name="name">cara.mia.registro.trabajo.orden.form</field>
        <field name="model">cara.mia.registro.trabajo.orden</field>
        <field name="arch" type="xml">
            <form string="Registro de Trabajo Realizado">
                <sheet>
                    <group>
                        <group string="Orden de Producción">
                            <field name="orden_codigo"
                                   placeholder="Escanee o escriba el código de la orden" 
                                   default_focus="1"/>
                            <field name="total_pares"/>
                            <field name="fecha"/>
                        </group>
                        <group string="Empleado que completó la tarea">
                            <field name="empleado_id" placeholder="Seleccionar operario..." options="{'no_create': True}"/>
                            <field name="tipo_labor_id"/>
                        </group>
                    </group>
                    <group string="Valor total de la labor realizada">
                        <group>
                            <field name="tarifa_pago" widget="monetary"/>
                            <field name="subtotal" widget="monetary"/>
                            <field name="estado" widget="badge" 
                                   decoration-warning="estado == 'sin_asignar'" 
                                   decoration-info="estado == 'pendiente'" 
                                   decoration-success="estado == 'pagado'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Lista -->
    <record id="view_caramia_registro_trabajo_orden_tree" model="ir.ui.view">
        <field name="name">cara.mia.registro.trabajo.orden.list</field>
        <field name="model">cara.mia.registro.trabajo.orden</field>
        <field name="arch" type="xml">
            <list string="Tiquetes Registrados">
                <field name="fecha" readonly="1"/>
                <field name="orden_codigo" readonly="1"/>
                <field name="total_pares" readonly="1"/>
                <field name="empleado_id" placeholder="Asignar empleado..."/>
                <field name="tipo_labor_id" readonly="1"/>
                <field name="tarifa_pago" widget="monetary" readonly="1"/>
                <field name="subtotal" widget="monetary" sum="Total acumulado" readonly="1"/>
                <field name="estado" widget="badge" 
                       decoration-warning="estado == 'sin_asignar'" 
                       decoration-info="estado == 'pendiente'" 
                       decoration-success="estado == 'pagado'"/>
            </list>
        </field>
    </record>
</odoo>