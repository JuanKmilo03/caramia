<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_pago_empleado" model="ir.actions.report">
        <field name="name">Comprobante de Nómina</field>
        <field name="model">cara.mia.pago.empleado</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">caramia_employee.report_pago_empleado_document</field>
        <field name="report_file">caramia_employee.report_pago_empleado_document</field>
        <field name="binding_model_id" ref="model_cara_mia_pago_empleado"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">(object.name or '').replace('/', '_')</field>
    </record>

    <template id="report_pago_empleado_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mb-4"><span t-field="o.name"/></h2>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Fecha de Realización:</strong> <span t-field="o.fecha_nomina"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Estado:</strong> <span t-field="o.state"/>
                            </div>
                        </div>

                        <table class="table table-bordered table-sm mt-3">
                            <thead>
                                <tr class="bg-light text-center">
                                    <th>Empleado</th>
                                    <th>Pares</th>
                                    <th>Bruto Labores</th>
                                    <th>Pago Liq.</th>
                                    <th>Reserva Liq. (0.22%)</th>
                                    <th>Valor a Pagar</th>
                                    <th>Estado Pago</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.linea_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.empleado_id.nombre_empleado"/></td>
                                        <td class="text-center"><span t-field="line.total_pares"/></td>
                                        <td class="text-end"><span t-field="line.monto_bruto" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        <td class="text-center">
                                            <span t-if="line.pago_liquidado">SÍ</span>
                                            <span t-else="">NO</span>
                                        </td>
                                        <td class="text-end"><span t-field="line.reserva" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        <td class="text-end fw-bold"><span t-field="line.monto_neto" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        <td class="text-center">
                                            <span t-if="line.pagado" class="text-success fw-bold">PAGADO</span>
                                            <span t-else="" class="text-warning">PENDIENTE</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt-4">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Total A Pagar:</strong></td>
                                        <td class="text-end fw-bold"><span t-field="o.total_neto" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total Pagado:</strong></td>
                                        <td class="text-end text-success fw-bold"><span t-field="o.total_pagado" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>